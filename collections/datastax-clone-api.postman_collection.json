      "name": "Clone",
      "description": {
        "content": "Use the DevOps API to clone databases.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0b326bb8-fb67-448b-a689-d0028edfcc42",
          "name": "List a database's snapshots.",
          "request": {
            "name": "List a database's snapshots.",
            "description": {
              "content": "List a database's snapshots.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "databases",
                ":databaseID",
                "snapshots"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "Optional timestamp in RFC3339 format. Sets the earliest time from which to fetch snapshots. If alone, fetches all available snapshots recorded on or after the given time. Use with 'to' to create a defined range."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "Optional timestamp in RFC3339 format. Sets the latest time from which to fetch snapshots. If alone, fetches all available snapshots recorded on or before the given time. Use with 'from' to create a defined range."
                },
                {
                  "disabled": false,
                  "key": "sourceRegion",
                  "value": "<string>",
                  "description": "When set then identifies which region to use as the source."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "databaseID",
                  "description": "(Required) String representation of the database ID"
                }
              ]
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
