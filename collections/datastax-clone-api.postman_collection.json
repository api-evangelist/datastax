              ],
              "query": [
                {
                  "disabled": false,
                  "key": "snapshotID",
                  "value": "<string>",
                  "description": "(Required) The ID of the snapshot from the source DB to use as the basis of the clone operation."
                },
                {
                  "disabled": false,
                  "key": "sourceRegion",
                  "value": "<string>",
                  "description": "The name of the region to use as the source, if cloning from a secondary region of a multi-region database."
